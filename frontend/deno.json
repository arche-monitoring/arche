{
  "name": "arche-frontend",
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "test": "deno test --allow-read --allow-env",
    "test:watch": "deno test --watch --allow-read --allow-env"
  },
  "nodeModulesDir": "manual",
  "imports": {
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.60.0",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "clsx": "npm:clsx@^2.1.1",
    "lucide-react": "npm:lucide-react@^0.460.0",
    "react": "npm:react@^18.3.1",
    "react-dom": "npm:react-dom@^18.3.1",
    "react-router-dom": "npm:react-router-dom@^6.28.0",
    "recharts": "npm:recharts@^2.14.1",
    "tailwind-merge": "npm:tailwind-merge@^2.6.0",
    "tailwindcss-animate": "npm:tailwindcss-animate@^1.0.7",
    "vaul": "npm:vaul@^1.1.1",
    "autoprefixer": "npm:autoprefixer@^10.4.20",
    "postcss": "npm:postcss@^8.4.49",
    "tailwindcss": "npm:tailwindcss@^3.4.16",
    "path": "node:path",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.7.0",
    "vitest": "npm:vitest@^3.2.6"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
