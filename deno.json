{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --watch backend/main.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys backend/main.ts",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt --check",
    "fmt:fix": "deno fmt",
    "db:generate": "deno run -A drizzle-kit generate --config=backend/database/drizzle.config.ts",
    "check": "deno check backend/main.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys"
  },
  "imports": {
    "hono": "npm:hono@^4.12.23",
    "sqlite": "https://deno.land/x/sqlite@v3.9.1/mod.ts",
    "imapflow": "npm:imapflow@^1.3.6",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "drizzle-kit": "npm:drizzle-kit@0.31.10",
    "@std/assert": "jsr:@std/assert@^1.0.12",
    "@std/testing": "jsr:@std/testing@^1.0.11"
  },
  "lint": {
    "exclude": ["frontend", "*md"]
  },
  "fmt": {
    "exclude": ["frontend", "*md"]
  },
  "exclude": ["frontend"]
}
