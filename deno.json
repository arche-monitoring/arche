{
  "tasks": {
    "dev": "deno run --v8-flags='--max-heap-size=256' --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --watch backend/main.ts",
    "dev:frontend": "cd frontend && deno run dev",
    "start": "deno run --no-check --v8-flags='--max-heap-size=256,--optimize-for-size' --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys backend/main.ts",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt --check",
    "fmt:fix": "deno fmt",
    "db:generate": "deno run -A drizzle-kit generate --config=backend/database/drizzle.config.ts",
    "check": "deno check backend/main.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys"
  },
  "imports": {
    "@types/better-sqlite3": "npm:@types/better-sqlite3@^7.6.13",
    "better-sqlite3": "npm:better-sqlite3@^12.10.0",
    "hono": "npm:hono@^4.12.24",
    "imapflow": "npm:imapflow@^1.3.7",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "drizzle-kit": "npm:drizzle-kit@0.31.10",
    "jose": "npm:jose@^6.2.3"
  },
  "nodeModulesDir": "auto",
  "lint": {
    "exclude": ["frontend", "*md"]
  },
  "fmt": {
    "exclude": ["frontend", "*md"]
  },
  "exclude": ["frontend"],
  "allowScripts": [
    "npm:better-sqlite3@12.10.0",
    "npm:esbuild@0.18.20",
    "npm:esbuild@0.25.12",
    "npm:esbuild@0.28.0",
    "npm:sqlite3@6.0.1"
  ]
}
